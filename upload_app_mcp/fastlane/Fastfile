require "dotenv"

Dotenv.load(File.expand_path(ENV.fetch("APP_STORE_CONNECT_ENV_FILE", "~/.config/app-store-connect/.env")))
ENV["SUPPLY_JSON_KEY"] ||= ENV["GOOGLE_APPLICATION_CREDENTIALS"]

SKIP_STORE_LISTING = {
  skip_upload_metadata: true,
  skip_upload_changelogs: true,
  skip_upload_images: true,
  skip_upload_screenshots: true
}.freeze

platform :android do
  lane :upload do |options|
    upload_to_play_store(
      package_name: options[:package_name],
      aab: options[:aab],
      track: options[:track] || "internal",
      **SKIP_STORE_LISTING
    )
  end

  lane :promote do |options|
    upload_to_play_store(
      package_name: options[:package_name],
      version_code: options[:version_code].to_i,
      track: options[:from_track] || "internal",
      track_promote_to: "production",
      rollout: options[:rollout],
      validate_only: options[:validate_only] == true,
      skip_upload_aab: true,
      skip_upload_apk: true,
      **SKIP_STORE_LISTING
    )
  end
end

platform :ios do
  before_all do
    app_store_connect_api_key(
      key_id: ENV.fetch("APP_STORE_CONNECT_KEY_ID"),
      issuer_id: ENV.fetch("APP_STORE_CONNECT_ISSUER_ID"),
      key_filepath: File.expand_path(ENV.fetch("APP_STORE_CONNECT_PRIVATE_KEY_PATH"))
    )
  end

  lane :upload do |options|
    upload_to_testflight(ipa: options[:ipa], skip_waiting_for_build_processing: true)
  end

  lane :release do |options|
    upload_to_app_store(
      app_identifier: options[:app_identifier],
      app_version: options[:app_version],
      build_number: options[:build_number],
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: true,
      submit_for_review: true,
      force: true,
      run_precheck_before_submit: false
    )
  end
end
